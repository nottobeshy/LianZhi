# Reference only; .env is NOT loaded automatically. Set terminal environment.
LLM_MODE=live
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=
# Optional: UI "remember API Key" uses Windows Credential Manager, never this file.
# At startup environment key overrides the saved credential; .env is NOT loaded.
# LLM_BASE_URL host also defines the trusted custom-provider allowlist at startup.
LLM_MAX_REQUESTS=3
# Optional writable directory; default LOCALAPPDATA/KnowledgeCompass.
# LIANZHI_DATA_DIR=
# Optional local ASR directory; default PROJECT_ROOT/models/faster-whisper-small.
# LIANZHI_ASR_MODEL_DIR=
# No automatic model downloads; see docs/ASR.md and requirements-asr.txt.
